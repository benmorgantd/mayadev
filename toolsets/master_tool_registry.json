        {
            "guid": "b2c664f6-76da-405d-960e-9846fa1a70c1",
            "name": "Print Joint Markup",
            "short_name": "Markup?",
            "script": "import maya.cmds as cmds\njoints = cmds.ls(sl=True, type='joint')\nif not joints:\n    raise RuntimeError('Select joints.')\nfor joint, markup in zip(joints, cmds.rigJointMarkup(*joints, query=True)):\n    print(f'{joint}: {markup}')\n",
            "icon": null,
            "enabled": true
        },
        {
            "guid": "e34dcbca-0f06-4406-93d1-afde0876f8dc",
            "name": "Remove Joint Markup",
            "short_name": "Markup X",
            "script": "import maya.cmds as cmds\njoints = cmds.ls(sl=True, type='joint')\nif not joints:\n    raise RuntimeError('Select joints.')\ncmds.rigJointMarkup(*joints, remove=True)\n",
            "icon": null,
            "enabled": true
        },
        {
            "guid": "de84cb3f-aae6-4494-a163-25c6778855ad",
