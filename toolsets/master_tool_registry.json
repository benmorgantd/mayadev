            "guid": "b2c664f6-76da-405d-960e-9846fa1a70c1",
            "name": "Print Joint Markup",
            "short_name": "Markup?",
            "script": "import maya.cmds as cmds\njoints = cmds.ls(sl=True, type='joint')\nif not joints:\n    raise RuntimeError('Select joints.')\nfor joint, markup in zip(joints, cmds.rigJointMarkup(*joints, query=True)):\n    print(f'{joint}: {markup}')\n",
            "icon": null,
            "enabled": true
        },
        {
