            "name": "Select Mirror Controls",
            "short_name": "Sel Mirror",
            "script": "import maya.cmds as cmds\ncontrols = cmds.ls(sl=True, type='rigControlNode')\nif not controls:\n    raise RuntimeError('Select rig controls.')\ncmds.select([cmds.getRigMirrorControl(c) for c in controls], replace=True)\n",
            "icon": null,
            "enabled": true
        },
