            "guid": "de84cb3f-aae6-4494-a163-25c6778855ad",
            "name": "Select All Controls",
            "short_name": "Sel Ctrls",
            "script": "import maya.cmds as cmds\nroots = cmds.ls(sl=True, type='rigRootModule')\nif len(roots) != 1:\n    raise RuntimeError('Select one rig root (rigRootModule).')\ncmds.select(cmds.getRigControls(roots[0]), replace=True)\n",
