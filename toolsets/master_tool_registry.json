            "short_name": "Sel Ctrls",
            "script": "import maya.cmds as cmds\nimport bmaya.maya.activerig\nrig_root = bmaya.maya.activerig.get_active_rig().rig_root\ncmds.select(cmds.getRigControls(rig_root), replace=True)\n",
            "icon": null,
            "enabled": true
        },
        {
